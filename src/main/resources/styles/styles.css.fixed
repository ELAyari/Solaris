/* JavaFX CSS - Define colors as constants */

/* We can't use CSS variables in JavaFX, so using direct values instead */

.root {
    -fx-primary-color: #00A67E;
    -fx-primary-light: #33BFA2;
    -fx-primary-dark: #008F6B;
    
    -fx-secondary-color: #3498DB;
    -fx-secondary-light: #5DADE2;
    -fx-secondary-dark: #2980B9;
    
    /* Accent Colors */
    -fx-accent-success: #2ECC71;
    -fx-accent-warning: #F1C40F;
    -fx-accent-danger: #E74C3C;
    
    /* Neutral Colors */
    -fx-neutral-100: #FFFFFF;
    -fx-neutral-200: #F8F9FA;
    -fx-neutral-300: #E9ECEF;
    -fx-neutral-400: #DEE2E6;
    -fx-neutral-500: #ADB5BD;
    -fx-neutral-600: #6C757D;
    -fx-neutral-700: #495057;
    -fx-neutral-800: #343A40;
    -fx-neutral-900: #212529;
    
    /* Shadows */
    -fx-shadow-sm: dropshadow(three-pass-box, rgba(0,0,0,0.05), 2, 0, 0, 2);
    -fx-shadow-md: dropshadow(three-pass-box, rgba(0,0,0,0.1), 4, 0, 0, 4);
    -fx-shadow-lg: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 10);
    
    /* Border Radius */
    -fx-radius-sm: 4px;
    -fx-radius-md: 8px;
    -fx-radius-lg: 16px;
    -fx-radius-full: 9999px;
    
    /* Spacing */
    -fx-space-1: 4px;
    -fx-space-2: 8px;
    -fx-space-3: 12px;
    -fx-space-4: 16px;
    -fx-space-5: 24px;
    -fx-space-6: 32px;
    
    /* Typography */
    -fx-font-family: "Segoe UI", system-ui, sans-serif;
    -fx-font-size-sm: 14px;
    -fx-font-size-base: 16px;
    -fx-font-size-lg: 18px;
    -fx-font-size-xl: 24px;
    -fx-font-size-2xl: 32px;
}

/* === Base Styles === */
.root {
    -fx-background-color: #f5fff5;
    -fx-font-family: "Segoe UI", system-ui, sans-serif;
}

/* === Header === */
.header {
    -fx-background-color: #2e7d32;
    -fx-padding: 15;
    -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);
}

.header-title {
    -fx-font-size: 24px;
    -fx-font-weight: bold;
    -fx-text-fill: white;
}

.header-username {
    -fx-font-size: 16px;
    -fx-text-fill: white;
    -fx-font-weight: 600;
}

.header-avatar {
    -fx-fill: #81c784;
    -fx-stroke: white;
    -fx-stroke-width: 2;
}

/* === Statistics Cards === */
.stat-card {
    -fx-background-color: white;
    -fx-padding: 20;
    -fx-background-radius: 10;
    -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);
    -fx-min-width: 200;
    -fx-alignment: CENTER_LEFT;
    -fx-spacing: 10;
}

.stat-title {
    -fx-font-size: 16px;
    -fx-text-fill: #2e7d32;
    -fx-font-weight: bold;
}

.stat-value {
    -fx-font-size: 28px;
    -fx-font-weight: bold;
    -fx-text-fill: #1b5e20;
}

/* === Map Container === */
.map-container {
    -fx-background-color: white;
    -fx-padding: 20;
    -fx-background-radius: 10;
    -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);
}

.section-title {
    -fx-font-size: 20px;
    -fx-font-weight: bold;
    -fx-text-fill: #2e7d32;
    -fx-padding: 0 0 10 0;
}

/* === Buttons === */
.btn-add-product {
    -fx-background-color: #4CAF50;
    -fx-text-fill: white;
    -fx-font-size: 14px;
    -fx-font-weight: bold;
    -fx-padding: 12 20;
    -fx-background-radius: 5;
    -fx-cursor: hand;
    -fx-min-width: 150;
}

.btn-add-product:hover {
    -fx-background-color: #388e3c;
}

.btn-add-product:pressed {
    -fx-background-color: #2e7d32;
}

/* === Map Markers === */
.marker-icon {
    -fx-background-color: white;
    -fx-background-radius: 50%;
    -fx-padding: 10;
    -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 5, 0, 0, 2);
}

.bin-marker {
    -fx-border-color: #4CAF50;
    -fx-border-width: 2;
}

.truck-marker {
    -fx-border-color: #2196F3;
    -fx-border-width: 2;
}

/* === Popup Styles === */
.popup-content {
    -fx-background-color: white;
    -fx-padding: 15;
    -fx-background-radius: 5;
}

.popup-title {
    -fx-font-size: 14px;
    -fx-font-weight: bold;
    -fx-text-fill: #2e7d32;
}

.popup-info {
    -fx-font-size: 12px;
    -fx-text-fill: #666;
}

/* === Fill Level Indicators === */
.fill-level {
    -fx-pref-height: 8;
    -fx-background-radius: 4;
}

.fill-level-low {
    -fx-accent: #4CAF50;
}

.fill-level-medium {
    -fx-accent: #FFC107;
}

.fill-level-high {
    -fx-accent: #F44336;
}

/* === Route Lines === */
.route-line {
    -fx-stroke: #2196F3;
    -fx-stroke-width: 3;
    -fx-stroke-dash-array: 10 5;
    -fx-opacity: 0.7;
}

/* === Alerts and Messages === */
.alert {
    -fx-background-color: white;
    -fx-padding: 15;
    -fx-background-radius: 5;
    -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);
}

.alert.warning {
    -fx-background-color: #FFF3CD;
    -fx-border-color: #FFEEBA;
}

.alert.success {
    -fx-background-color: #D4EDDA;
    -fx-border-color: #C3E6CB;
}

.alert.error {
    -fx-background-color: #F8D7DA;
    -fx-border-color: #F5C6CB;
}

.alert-title {
    -fx-font-size: 18px;
    -fx-font-weight: bold;
}

.alert-message {
    -fx-font-size: 14px;
}

.alert-icon {
    -fx-fill: #2e7d32;
}

.alert-icon.warning {
    -fx-fill: #FFC107;
}

.alert-icon.error {
    -fx-fill: #F44336;
}

/* === Dashboard Layout === */
.dashboard-container {
    -fx-background-color: #f9fafb;
    -fx-padding: 20;
}

/* === En-têtes === */
.header {
    -fx-background-color: #2e7d32;
    -fx-padding: 15;
    -fx-alignment: center;
}

.header-title {
    -fx-font-size: 24px;
    -fx-font-weight: bold;
    -fx-text-fill: white;
}

/* === Conteneurs de formulaire === */
.form-container {
    -fx-background-color: white;
    -fx-background-radius: 10;
    -fx-padding: 20;
    -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);
    -fx-border-color: #a5d6a7;
    -fx-border-width: 1px;
    -fx-border-radius: 10;
}

.form-title {
    -fx-font-weight: bold;
    -fx-font-size: 20px;
    -fx-text-fill: #2e7d32;
    -fx-padding: 0 0 15 0;
}

.form-label {
    -fx-font-weight: bold;
    -fx-text-fill: #333;
    -fx-padding: 5 0;
}

.form-input {
    -fx-border-color: #a5d6a7;
    -fx-border-radius: 5;
    -fx-border-width: 1px;
    -fx-background-radius: 5;
    -fx-padding: 8 10;
}

.form-button {
    -fx-background-color: #4CAF50;
    -fx-text-fill: white;
    -fx-font-weight: bold;
    -fx-padding: 10 20;
    -fx-background-radius: 5;
    -fx-cursor: hand;
}

.form-button:hover {
    -fx-background-color: #388e3c;
}

/* === Boutons spécifiques === */
.btn-show-map {
    -fx-background-color: #4CAF50;
}

.btn-show-map:hover {
    -fx-background-color: #388e3c;
}

/* === Tableaux === */
.product-table {
    -fx-background-color: white;
    -fx-border-color: #a5d6a7;
    -fx-border-width: 2px;
}

.product-table .column-header {
    -fx-background-color: #2e7d32;
    -fx-text-fill: white;
    -fx-font-weight: bold;
    -fx-font-size: 14px;
}

.product-table .table-row-cell {
    -fx-background-color: white;
}

.product-table .table-row-cell:odd {
    -fx-background-color: #f5fff5;
}

.product-table .table-row-cell:selected {
    -fx-background-color: #a5d6a7;
}

/* === En-têtes de tableaux === */
.column-header {
    -fx-background-color: #2e7d32;
    -fx-text-fill: white;
    -fx-font-weight: bold;
    -fx-padding: 8 15;
}

/* === Éléments de tableaux === */
.table-row-cell {
    -fx-border-color: #e0e0e0;
    -fx-border-width: 0 0 1px 0;
}

.table-cell {
    -fx-alignment: CENTER_LEFT;
    -fx-padding: 5;
    -fx-border-color: #e0e0e0;
    -fx-border-width: 0 1px 0 0;
}

.table-cell:last-visible {
    -fx-border-width: 0;
}

.table-view .placeholder {
    -fx-background-color: white;
    -fx-border-color: #c8e6c9;
    -fx-border-width: 0 1px 1px 1px;
}

/* === Badges === */
.recyclable-badge {
    -fx-background-color: #4caf50;
    -fx-text-fill: white;
    -fx-padding: 3 10;
    -fx-background-radius: 15;
}

/* === Combobox === */
.category-combo {
    -fx-pref-width: 200;
    -fx-background-color: white;
    -fx-border-color: #81c784;
}

/* === Barres d'outils === */
.toolbar, .action-bar {
    -fx-spacing: 15;
    -fx-padding: 10 0;
}

/* === Form Input States === */
.text-field:focused, .text-area:focused, .combo-box:focused {
    -fx-border-color: #4CAF50;
    -fx-border-width: 2px;
}

.text-field:hover, .text-area:hover, .combo-box:hover {
    -fx-border-color: #81c784;
}

.text-field.error, .text-area.error, .combo-box.error {
    -fx-border-color: #F44336;
}

.validation-message {
    -fx-text-fill: #F44336;
    -fx-font-size: 12px;
    -fx-font-style: italic;
}

/* styles.css */
#mapView {
    -fx-border-color: #ccc;
    -fx-border-radius: 5px;
    -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 2);
}

.map-status {
    -fx-font-style: italic;
    -fx-text-fill: #0064ff;
}

/* === Cartes === */
.bin-card, .truck-card {
    -fx-background-color: white;
    -fx-background-radius: 8;
    -fx-padding: 15;
    -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 2, 2);
    -fx-min-width: 280;
    -fx-max-width: 280;
}

.card-title {
    -fx-font-size: 18px;
    -fx-font-weight: bold;
    -fx-text-fill: #2e7d32;
}

.card-subtitle {
    -fx-font-size: 14px;
    -fx-text-fill: #666;
}

.card-icon {
    -fx-fill: #4CAF50;
}

.bin-card:hover, .truck-card:hover {
    -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 10, 0, 5, 5);
    -fx-cursor: hand;
}

/* === Dialog Styles === */
.dialog-pane {
    -fx-background-color: white;
}

.dialog-pane .header {
    -fx-background-color: #4CAF50;
    -fx-text-fill: white;
}

.dialog-pane .content {
    -fx-padding: 15;
}

.dialog-pane .button-bar {
    -fx-padding: 10;
}

.alert.warning.dialog-pane {
    -fx-background-color: #FFF3CD;
}

.alert.warning .header-panel {
    -fx-background-color: #FFEEBA;
}

.alert.warning .content.label {
    -fx-text-fill: #856404;
}

.map-status-label {
    -fx-text-fill: #666;
    -fx-font-size: 12px;
    -fx-padding: 5 0 0 0;
}

.form-input {
    -fx-pref-width: 200px;
}

.start-icon {
    -fx-background-color: rgba(255, 255, 255, 0.7);
    -fx-background-radius: 50%;
    -fx-padding: 5;
}

.end-icon {
    -fx-background-color: rgba(255, 255, 255, 0.7);
    -fx-background-radius: 50%;
    -fx-padding: 5;
}

.leaflet-popup-content {
    -fx-font-size: 14px;
    -fx-font-weight: bold;
}

.table-view {
    -fx-font-size: 14px;
}

.table-view .column-header {
    -fx-background-color: #2c3e50;
    -fx-text-fill: white;
    -fx-font-weight: bold;
}

.table-row-cell:odd {
    -fx-background-color: #f9f9f9;
}

.table-row-cell:selected {
    -fx-background-color: #3498db;
    -fx-text-fill: white;
}

/* Ajoutez dans styles.css */
.table-tab-pane {
    -fx-padding: 10px;
}

.main-tab-pane {
    -fx-padding: 10px;
}

.data-table {
    -fx-font-size: 14px;
}

.data-table .column-header {
    -fx-background-color: #2c3e50;
    -fx-text-fill: white;
}

.dashboard-content {
    -fx-padding: 20px;
}

/* === Solaris Route Optimization Styles === */
.stations-panel {
    -fx-background-color: -fx-neutral-100;
    -fx-padding: -fx-space-4;
    -fx-effect: -fx-shadow-sm;
}

.stats-panel {
    -fx-background-color: -fx-neutral-200;
    -fx-padding: -fx-space-3;
    -fx-background-radius: -fx-radius-md;
}

.stat-value {
    -fx-font-size: -fx-font-size-lg;
    -fx-font-weight: bold;
    -fx-text-fill: -fx-primary-color;
}

#mapView {
    -fx-background-color: -fx-neutral-100;
    -fx-border-color: -fx-neutral-300;
    -fx-border-width: 1px;
    -fx-border-radius: -fx-radius-md;
}

.primary-button {
    -fx-background-color: -fx-primary-color;
    -fx-text-fill: white;
    -fx-font-weight: bold;
    -fx-padding: -fx-space-2 -fx-space-4;
    -fx-background-radius: -fx-radius-md;
    -fx-cursor: hand;
}

.primary-button:hover {
    -fx-background-color: -fx-primary-dark;
}

.footer {
    -fx-background-color: -fx-neutral-100;
    -fx-border-color: -fx-neutral-300;
    -fx-border-width: 1px 0 0 0;
}

.footer-text {
    -fx-text-fill: -fx-neutral-600;
    -fx-font-size: -fx-font-size-sm;
}

.version-text {
    -fx-text-fill: -fx-neutral-500;
    -fx-font-size: -fx-font-size-sm;
}

/* Table Styles */
.table-view {
    -fx-background-color: transparent;
    -fx-border-color: -fx-neutral-300;
    -fx-border-width: 1px;
    -fx-border-radius: -fx-radius-md;
}

.table-view .column-header {
    -fx-background-color: -fx-neutral-200;
    -fx-padding: -fx-space-2;
}

.table-view .column-header .label {
    -fx-text-fill: -fx-neutral-700;
    -fx-font-weight: bold;
}

.table-row-cell {
    -fx-background-color: transparent;
    -fx-border-color: transparent;
}

.table-row-cell:odd {
    -fx-background-color: -fx-neutral-100;
}

.table-row-cell:hover {
    -fx-background-color: -fx-primary-light;
    -fx-text-fill: white;
}

/* Progress Bar Styles */
.progress-bar {
    -fx-accent: -fx-primary-color;
    -fx-background-color: -fx-neutral-200;
    -fx-background-radius: -fx-radius-full;
}

.progress-bar .track {
    -fx-background-color: -fx-neutral-200;
    -fx-background-radius: -fx-radius-full;
}

.progress-bar .bar {
    -fx-background-radius: -fx-radius-full;
}

/* Notes style */
.notes {
    -fx-font-style: italic;
    -fx-text-fill: -fx-neutral-600;
    -fx-font-size: -fx-font-size-sm;
    -fx-padding: -fx-space-2;
    -fx-background-color: -fx-neutral-200;
    -fx-background-radius: -fx-radius-md;
    -fx-border-color: -fx-neutral-300;
    -fx-border-width: 1px;
    -fx-border-radius: -fx-radius-md;
}
