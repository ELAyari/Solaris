<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="800" prefWidth="1200" stylesheets="styles/common.css,styles/admin_dashboard_fixed.css,styles/dashboard_cards.css" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17.0.12" fx:controller="com.esprit.controllers.LimitedAccessController">

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="70" spacing="20" styleClass="header">
            <padding>
                <Insets left="30" right="30" />
            </padding>
            <Label styleClass="header-title" text="Limited Access" />
            <HBox alignment="CENTER_RIGHT" spacing="15" HBox.hgrow="ALWAYS">
                <Label fx:id="lblUsername" styleClass="header-username" />
                <Button fx:id="btnLogout" styleClass="sidebar-button" text="🚪 Logout" onAction="#handleLogout" />
            </HBox>
        </HBox>
    </top>

    <left>
        <VBox styleClass="sidebar">
            <padding>
                <Insets bottom="20" left="20" right="20" top="20" />
            </padding>
            
            <Label styleClass="sidebar-title" text="Menu">
                <VBox.margin>
                    <Insets bottom="20" />
                </VBox.margin>
            </Label>
            
            <!-- Sidebar buttons can be added here if needed, or keep minimal -->
            
            <Region VBox.vgrow="ALWAYS" />
            
            <Button fx:id="btnLogoutSidebar" onAction="#handleLogout" styleClass="sidebar-button" text="🚪 Logout" />
        </VBox>
    </left>

    <center>
        <VBox alignment="CENTER" spacing="20" styleClass="main-content" BorderPane.alignment="CENTER">
            <Label fx:id="lblWelcome" styleClass="section-title" text="Welcome, User!" />
            <Label text="Please contact your admin for full access." styleClass="content-section" />
        </VBox>
    </center>

</BorderPane>
