<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.text.Font?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.esprit.controllers.GifPickerController"
      spacing="15" alignment="CENTER_LEFT"
      style="-fx-background-color: white; -fx-border-color: #ddd; -fx-padding: 15; -fx-background-radius: 8;"
      prefWidth="800" prefHeight="400" VBox.vgrow="ALWAYS">

    <!-- Header with title and search field -->
    <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-padding: 5;">
        <Text text="GIF Picker" style="-fx-fill: #3498db; -fx-font-weight: bold;">
            <font>
                <Font size="18" />
            </font>
        </Text>
        
        <TextField fx:id="gifSearchField" promptText="Search for GIFs..." HBox.hgrow="ALWAYS"
                   style="-fx-background-color: #f5f5f5; -fx-border-color: #ddd; -fx-border-radius: 20; 
                          -fx-background-radius: 20; -fx-padding: 8 15; -fx-font-size: 14px;" />
        
        <Button fx:id="gifCloseButton" text="Close" onAction="#handleClose"
                style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; 
                       -fx-background-radius: 5; -fx-padding: 8 15;" />
    </HBox>
    
    <!-- Category buttons for quick selection -->
    <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 5;">
        <Button text="Trending" onAction="#handleTrendingCategory"
                style="-fx-background-color: #3498db; -fx-text-fill: white; 
                       -fx-background-radius: 15; -fx-padding: 5 15;" />
        <Button text="Emojis" onAction="#handleEmojisCategory"
                style="-fx-background-color: #f1c40f; -fx-text-fill: white; 
                       -fx-background-radius: 15; -fx-padding: 5 15;" />
        <Button text="Reactions" onAction="#handleReactionsCategory"
                style="-fx-background-color: #2ecc71; -fx-text-fill: white; 
                       -fx-background-radius: 15; -fx-padding: 5 15;" />
        <Button text="Funny" onAction="#handleFunnyCategory"
                style="-fx-background-color: #f39c12; -fx-text-fill: white; 
                       -fx-background-radius: 15; -fx-padding: 5 15;" />
        <Button text="Love" onAction="#handleLoveCategory"
                style="-fx-background-color: #e74c3c; -fx-text-fill: white; 
                       -fx-background-radius: 15; -fx-padding: 5 15;" />
        <Button text="Animals" onAction="#handleAnimalsCategory"
                style="-fx-background-color: #9b59b6; -fx-text-fill: white; 
                       -fx-background-radius: 15; -fx-padding: 5 15;" />
    </HBox>

    <!-- Loading indicator -->
    <StackPane>
        <ProgressIndicator fx:id="loadingIndicator" visible="false" maxWidth="60" maxHeight="60" />
    </StackPane>

    <!-- GIF display area -->
    <ScrollPane fx:id="gifScrollPane" fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background-color: transparent; -fx-border-color: transparent;">
        <FlowPane fx:id="gifFlowPane" hgap="15" vgap="15" style="-fx-padding: 10;" />
    </ScrollPane>

</VBox>
