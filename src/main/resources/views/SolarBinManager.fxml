<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import java.net.URL?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.esprit.controllers.SolarBinManagerController"
            styleClass="dashboard-root">
            
    <!-- Link to styles -->
    <stylesheets>
        <URL value="@../styles/profile.css" />
        <URL value="@../styles/styles.css" />
        <URL value="@../styles/sidebar.css" />
        <URL value="@../styles/header.css" />
        <URL value="@../styles/content.css" />
    </stylesheets>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true" styleClass="content-area">
            <content>
                <VBox spacing="20">
                    <padding>
                        <Insets top="20" right="20" bottom="20" left="20"/>
                    </padding>
                    
                    <!-- Solar Bins Table -->
                    <VBox styleClass="card" spacing="10">
                        <Label text="Solar Powered Bins" styleClass="section-title"/>
                        <TableView fx:id="solarBinsTable" styleClass="data-table" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="idColumn" text="ID" prefWidth="50"/>
                                <TableColumn fx:id="locationColumn" text="Location" prefWidth="180"/>
                                <TableColumn fx:id="typeColumn" text="Waste Type" prefWidth="100"/>
                                <TableColumn fx:id="fillLevelColumn" text="Fill Level (%)" prefWidth="100"/>
                                <TableColumn fx:id="batteryLevelColumn" text="Battery (%)" prefWidth="100"/>
                                <TableColumn fx:id="energyStatusColumn" text="Energy Status" prefWidth="120"/>
                                <TableColumn fx:id="maintenanceDateColumn" text="Last Maintenance" prefWidth="150"/>
                            </columns>
                        </TableView>
                    </VBox>
                    
                    <!-- Performance Stats Cards -->
                    <HBox spacing="20">
                        <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="10">
                            <Label text="Battery Performance" styleClass="section-title"/>
                            <HBox spacing="20">
                                <VBox styleClass="stat-card" spacing="5">
                                    <Label text="Average Battery Level" styleClass="stat-title"/>
                                    <Label text="72%" styleClass="stat-value" style="-fx-text-fill: #10b981;"/>
                                </VBox>
                                <VBox styleClass="stat-card" spacing="5">
                                    <Label text="Low Battery Bins" styleClass="stat-title"/>
                                    <Label text="3" styleClass="stat-value" style="-fx-text-fill: #ef4444;"/>
                                </VBox>
                                <VBox styleClass="stat-card" spacing="5">
                                    <Label text="Maintenance Needed" styleClass="stat-title"/>
                                    <Label text="2" styleClass="stat-value" style="-fx-text-fill: #f59e0b;"/>
                                </VBox>
                            </HBox>
                        </VBox>
                    </HBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
    
    <right>
        <VBox spacing="20" prefWidth="300" styleClass="content-area">
            <padding>
                <Insets top="20" right="20" bottom="20" left="0"/>
            </padding>
            
            <!-- Battery Management Panel -->
            <VBox styleClass="card" spacing="15">
                <Label text="Battery Management" styleClass="section-title"/>
                
                <VBox spacing="10" styleClass="form-group">
                    <Label text="Battery Level Adjustment:" styleClass="form-label"/>
                    <HBox spacing="10" alignment="CENTER">
                        <Slider fx:id="batteryLevelSlider" min="0" max="100" value="50" 
                                showTickLabels="true" showTickMarks="true" 
                                majorTickUnit="25" minorTickCount="5" 
                                snapToTicks="true" HBox.hgrow="ALWAYS"/>
                        <Label fx:id="batteryLevelLabel" text="50%" minWidth="40" styleClass="stat-value"/>
                    </HBox>
                    <Button fx:id="updateBatteryBtn" text="Update Battery Level" styleClass="primary-button" maxWidth="Infinity"/>
                </VBox>
                
                <Separator/>
                
                <Label text="Simulation Controls" styleClass="form-label"/>
                <HBox spacing="10">
                    <Button text="Simulate Charging" onAction="#simulateCharging" styleClass="success-button" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                    <Button text="Simulate Usage" onAction="#simulateUsage" styleClass="secondary-button" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                </HBox>
            </VBox>
            
            <!-- Maintenance Panel -->
            <VBox styleClass="card" spacing="15">
                <Label text="Maintenance Scheduling" styleClass="section-title"/>
                
                <VBox spacing="10" styleClass="form-group">
                    <Label text="Next Maintenance Date:" styleClass="form-label"/>
                    <DatePicker fx:id="maintenanceDatePicker" styleClass="form-input" maxWidth="Infinity"/>
                </VBox>
                
                <VBox spacing="10" styleClass="form-group">
                    <Label text="Maintenance Notes:" styleClass="form-label"/>
                    <TextArea fx:id="maintenanceNotesArea" styleClass="form-input" prefHeight="100"/>
                </VBox>
                
                <Button fx:id="scheduleMaintenanceBtn" text="Schedule Maintenance" styleClass="primary-button" maxWidth="Infinity"/>
            </VBox>
        </VBox>
    </right>
    
    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10">
            <padding>
                <Insets top="10" right="15" bottom="15" left="15"/>
            </padding>
            <Label text="Green Energy Smart Bin Management System" style="-fx-font-style: italic;"/>
        </HBox>
    </bottom>
</BorderPane>
