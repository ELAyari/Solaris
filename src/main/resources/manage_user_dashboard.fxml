<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>
<?import java.net.URL?>

<VBox prefHeight="800" prefWidth="1200"
      xmlns:fx="http://javafx.com/fxml/1"
      xmlns="http://javafx.com/javafx/17"
      fx:controller="com.esprit.controllers.ManageUserDashboardController"
      spacing="20">

    <stylesheets>
        <URL value="@styles/common.css" />
        <URL value="@styles/manage_users.css" />
        <URL value="@styles/table.css" />
        <URL value="@styles/modern_ui.css" />
    </stylesheets>

    <padding>
        <Insets top="20" right="30" bottom="20" left="30"/>
    </padding>

    <!-- Centered Title -->
    <HBox alignment="CENTER">
        <Label styleClass="content-title" text="Manage Users" />
    </HBox>

    <!-- Search and Action Bar -->
    <HBox spacing="15" alignment="CENTER">
        <!-- Modern Search Container -->
        <HBox styleClass="search-container" alignment="CENTER_LEFT" prefWidth="350">
            <SVGPath content="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                     styleClass="search-icon" />
            <TextField fx:id="tfSearch" promptText="Search by email" styleClass="search-field" HBox.hgrow="ALWAYS"
                       style="-fx-text-fill: #333333; -fx-prompt-text-fill: #888888;" />

            <Button fx:id="btnClearSearch" styleClass="clear-search-button" onAction="#handleClearSearch">
                <graphic>
                    <SVGPath content="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                             styleClass="clear-icon" />
                </graphic>
            </Button>
        </HBox>

        <Region HBox.hgrow="ALWAYS" />

        <!-- Action Buttons -->
        <Button fx:id="btnAddUserManageDashboard" onAction="#handleAddUser" styleClass="action-button">
            <graphic>
                <HBox spacing="5" alignment="CENTER">
                    <SVGPath content="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" styleClass="button-icon" />
                    <Label text="Add User" styleClass="button-text" />
                </HBox>
            </graphic>
        </Button>
        <Button fx:id="btnModifyUser" onAction="#handleModifyUser" styleClass="action-button">
            <graphic>
                <HBox spacing="5" alignment="CENTER">
                    <SVGPath content="M3,17.25V21H6.75L17.81,9.94L14.06,6.19L3,17.25M20.71,7.04C21.1,6.65 21.1,6.02 20.71,5.63L18.37,3.29C17.98,2.9 17.35,2.9 16.96,3.29L15.13,5.12L18.88,8.87L20.71,7.04Z" styleClass="button-icon" />
                    <Label text="Modify User" styleClass="button-text" />
                </HBox>
            </graphic>
        </Button>
        <Button fx:id="btnDeleteUser" onAction="#handleDeleteUser" styleClass="action-button">
            <graphic>
                <HBox spacing="5" alignment="CENTER">
                    <SVGPath content="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z" styleClass="button-icon" />
                    <Label text="Ban User" styleClass="button-text" />
                </HBox>
            </graphic>
        </Button>
    </HBox>

    <!-- User Table -->
    <TableView fx:id="userTable" VBox.vgrow="ALWAYS" minHeight="550" prefHeight="600">
        <columns>
            <TableColumn fx:id="colNom" text="Last Name" prefWidth="120">
                <cellValueFactory><PropertyValueFactory property="nom" /></cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="colPrenom" text="First Name" prefWidth="120">
                <cellValueFactory><PropertyValueFactory property="prenom" /></cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="colEmail" text="Email" prefWidth="180">
                <cellValueFactory><PropertyValueFactory property="email" /></cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="colRole" text="Role" prefWidth="120">
                <cellValueFactory><PropertyValueFactory property="role" /></cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="colStatus" text="Status" prefWidth="120">
                <cellValueFactory><PropertyValueFactory property="status" /></cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="colAddress" text="Address" prefWidth="150">
                <cellValueFactory><PropertyValueFactory property="address" /></cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="colPhoneNumber" text="Phone" prefWidth="120">
                <cellValueFactory><PropertyValueFactory property="phoneNumber" /></cellValueFactory>
            </TableColumn>
        </columns>
        <placeholder>
            <Label text="No users found" />
        </placeholder>
    </TableView>
</VBox>