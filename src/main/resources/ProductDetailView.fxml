<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.shape.Circle?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:id="rootPane"
            fx:controller="com.esprit.controllers.ProductDetailController"
            prefWidth="1000" prefHeight="700"
            stylesheets="@/styles/client-product-detail.css">

    <top>
        <HBox styleClass="nav-bar" alignment="CENTER_LEFT" spacing="15">
            <padding><Insets top="20" right="30" bottom="20" left="30"/></padding>
            <Button fx:id="backButton" text="← Back to Products" onAction="#handleBack" styleClass="btn-back"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Product Details" styleClass="page-title"/>
        </HBox>
    </top>
    
    <center>
        <ScrollPane fitToWidth="true" styleClass="main-scroll-pane">
            <VBox spacing="40" styleClass="detail-container">
                <padding><Insets top="40" right="50" bottom="50" left="50"/></padding>
                
                <!-- Product Header Section -->
                <HBox spacing="50" alignment="TOP_LEFT">
                    <!-- Image Container with Badge -->
                    <VBox styleClass="image-section">
                        <StackPane styleClass="image-stack">
                            <VBox styleClass="image-container" alignment="CENTER">
                                <ImageView fx:id="productImageView" fitWidth="400" fitHeight="400" preserveRatio="true" smooth="true" styleClass="product-image" />
                            </VBox>
                            <Label fx:id="recyclableBadge" text="♻️ Eco-Friendly" styleClass="recyclable-badge" StackPane.alignment="TOP_RIGHT" />
                        </StackPane>
                    </VBox>
                    
                    <!-- Product Info Container -->
                    <VBox spacing="25" styleClass="info-container" HBox.hgrow="ALWAYS">
                        <!-- Company Info (if available) -->
                        <HBox fx:id="companyBox" spacing="12" alignment="CENTER_LEFT" styleClass="company-box">
                            <ImageView fx:id="companyLogoView" fitWidth="35" fitHeight="35" preserveRatio="true" styleClass="company-logo"/>
                            <Label fx:id="companyNameLabel" styleClass="company-name"/>
                        </HBox>
                        
                        <!-- Product Name and Price -->
                        <VBox spacing="8">
                            <Label fx:id="productNameLabel" styleClass="product-name"/>
                            <Label fx:id="productPriceLabel" styleClass="product-price"/>
                        </VBox>
                        
                        <!-- Stock Status -->
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label fx:id="stockStatusLabel" styleClass="stock-status"/>
                            <Label fx:id="stockCountLabel" styleClass="stock-count"/>
                        </HBox>
                        
                        <Separator styleClass="separator"/>
                        
                        <!-- Product Specifications -->
                        <VBox spacing="15" styleClass="specs-section">
                            <Label text="Product Details" styleClass="specs-title"/>
                            <GridPane styleClass="specs-grid" hgap="25" vgap="12">
                                <columnConstraints>
                                    <ColumnConstraints percentWidth="35"/>
                                    <ColumnConstraints percentWidth="65"/>
                                </columnConstraints>
                                
                                <Label text="Category:" styleClass="spec-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                <Label fx:id="categoryLabel" styleClass="spec-value" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                                            <Label text="Material:" styleClass="spec-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                                <Label text="Premium Quality" styleClass="spec-value" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                                
                                <Label text="Warranty:" styleClass="spec-label" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                                <Label text="2 Years" styleClass="spec-value" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                            </GridPane>
                        </VBox>
                        
                        <Separator styleClass="separator"/>
                        
                        <!-- Purchase Controls -->
                        <VBox spacing="20" styleClass="purchase-section">
                            <HBox spacing="20" alignment="CENTER_LEFT" styleClass="quantity-box">
                                <Label text="Quantity:" styleClass="quantity-label"/>
                                <ComboBox fx:id="quantityComboBox" prefWidth="120" styleClass="quantity-combo"/>
                            </HBox>
                            
                            <HBox spacing="15" styleClass="button-box">
                                <Button fx:id="addToCartButton" text="🛒 Add to Cart" onAction="#handleAddToCart" styleClass="btn-add-to-cart"/>
                                <Button fx:id="addToWishlistButton" text="❤️ Add to Wishlist" onAction="#handleAddToWishlist" styleClass="btn-add-to-wishlist"/>
                            </HBox>
                        </VBox>
                    </VBox>
                </HBox>
                
                <!-- Description Section -->
                <VBox spacing="20" styleClass="description-section">
                    <Label text="Product Description" styleClass="section-title"/>
                    <VBox styleClass="description-card">
                        <ScrollPane fitToWidth="true" prefHeight="150" styleClass="description-scroll">
                            <Label fx:id="productDescriptionLabel" wrapText="true" styleClass="description-text"/>
                        </ScrollPane>
                    </VBox>
                </VBox>

                <!-- Similar Products Section -->
                <VBox spacing="20" styleClass="similar-products-section">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="You May Also Like" styleClass="section-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <ScrollPane fx:id="similarProductsScrollPane" fitToHeight="true" fitToWidth="true" 
                                hbarPolicy="AS_NEEDED" vbarPolicy="NEVER" styleClass="similar-products-scroll">
                        <HBox fx:id="similarProductsContainer" spacing="25" styleClass="similar-products-container">
                            <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>
                        </HBox>
                    </ScrollPane>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
