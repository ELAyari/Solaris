<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.SVGPath?>

<!-- Root container changed to VBox for fragment -->
<ScrollPane fitToWidth="true" styleClass="profile-scroll-pane" xmlns="http://javafx.com/javafx/17.0.2-ea"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.esprit.controllers.UserProfileController">
    <stylesheets>
        <URL value="@styles/common.css" />
        <URL value="@styles/profile.css" />
        <URL value="@styles/animations.css" />
        <URL value="@styles/modern_effects.css" />
    </stylesheets>

    <VBox fx:id="profileRoot" styleClass="profile-content-wrapper" spacing="30">
        <!-- Hero Banner with Profile Image -->
        <VBox styleClass="profile-hero-banner">
            <HBox alignment="CENTER_LEFT" styleClass="banner-content">
                <StackPane styleClass="avatar-container">
                    <Circle fx:id="imgAvatar" radius="60" styleClass="profile-avatar" />
                </StackPane>
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label fx:id="lblUsername" styleClass="profile-name" text="Username" />
                    <Label fx:id="lblUserRole" styleClass="profile-role" text="User Role" />
                </VBox>
                <Button fx:id="btnChangePhoto" styleClass="change-photo-button">
                    <graphic>
                        <HBox spacing="8" alignment="CENTER">
                            <SVGPath content="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z" styleClass="button-icon"/>
                            <Label text="Change Photo" styleClass="button-text"/>
                        </HBox>
                    </graphic>
                </Button>
            </HBox>
        </VBox>

        <!-- Main Content -->
        <VBox styleClass="profile-sections-container">
            <!-- Personal Information Card -->
            <VBox fx:id="personalInfoSection" styleClass="profile-card">
                <HBox styleClass="card-header">
                    <SVGPath content="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z" styleClass="card-icon"/>
                    <Label styleClass="card-title" text="Personal Information" />
                </HBox>

                <VBox styleClass="card-content" spacing="15">
                    <VBox spacing="8">
                        <Label styleClass="field-label" text="Full Name" />
                        <TextField fx:id="txtFullName" promptText="Full Name" styleClass="profile-field" />
                    </VBox>

                    <VBox spacing="8">
                        <Label styleClass="field-label" text="Phone Number" />
                        <TextField fx:id="txtPhone" promptText="Phone Number" styleClass="profile-field" />
                    </VBox>

                    <VBox spacing="8">
                        <Label styleClass="field-label" text="Address" />
                        <TextArea fx:id="txtAddress" prefRowCount="3" promptText="Address" styleClass="profile-area">
                            <!-- Force white background -->
                            <style>
                                -fx-background-color: white;
                                -fx-control-inner-background: white;
                            </style>
                        </TextArea>                    </VBox>
                </VBox>
            </VBox>

            <!-- Account Information Card -->
            <VBox fx:id="accountInfoSection" styleClass="profile-card">
                <HBox styleClass="card-header">
                    <SVGPath content="M20,8L12,13L4,8V6L12,11L20,6M20,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V6C22,4.89 21.1,4 20,4Z" styleClass="card-icon"/>
                    <Label styleClass="card-title" text="Account Information" />
                </HBox>

                <VBox styleClass="card-content" spacing="15">
                    <VBox spacing="8">
                        <Label styleClass="field-label" text="Email Address" />
                        <TextField fx:id="txtEmail" promptText="Email Address" styleClass="profile-field" />
                    </VBox>

                    <VBox spacing="8">
                        <Label styleClass="field-label" text="Role" />
                        <TextField fx:id="txtRole" promptText="User Role" styleClass="profile-field" disable="true" />
                    </VBox>
                </VBox>
            </VBox>

            <!-- Save Button -->
            <HBox styleClass="actions-container">
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="btnSaveProfile" styleClass="save-button">
                    <graphic>
                        <HBox spacing="8" alignment="CENTER">
                            <SVGPath content="M17 3H5C3.89 3 3 3.9 3 5V19C3 20.1 3.89 21 5 21H19C20.1 21 21 20.1 21 19V7L17 3M19 19H5V5H16.17L19 7.83V19M12 12C10.34 12 9 13.34 9 15S10.34 18 12 18 15 16.66 15 15 13.66 12 12 12M6 6H15V10H6V6Z" styleClass="button-icon"/>
                            <Label text="Save Changes" styleClass="button-text"/>
                        </HBox>
                    </graphic>
                </Button>
            </HBox>
        </VBox>
    </VBox>
</ScrollPane>