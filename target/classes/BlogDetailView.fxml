<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.esprit.controllers.BlogDetailController"
            style="-fx-background-color: #f8f9fa;"
            stylesheets="@/styles/comments.css">

    <center>
        <ScrollPane fx:id="scrollPane" fitToWidth="true"
                    style="-fx-background: white; -fx-background-color: transparent;"
                    styleClass="blog-scrollpane"
                    stylesheets="@/styles/styles.css">
            <VBox fx:id="mainContainer" spacing="20" style="-fx-padding: 20;" alignment="TOP_CENTER">
                <!-- Header -->
                <VBox spacing="10" alignment="CENTER"
                      maxWidth="Infinity"
                      style="-fx-background-color: linear-gradient(to bottom, #a8e063, #56ab2f); 
                             -fx-padding: 30; 
                             -fx-background-radius: 10;">
                    <Label fx:id="titleLabel" 
                           style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: white; 
                                  -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 10, 0, 0, 2);" />
                    <HBox spacing="15" alignment="CENTER">
                        <Label fx:id="authorLabel" style="-fx-font-size: 16px; -fx-text-fill: white;" />
                        <Label text="•" style="-fx-text-fill: white;" />
                        <Label fx:id="dateLabel" style="-fx-font-size: 16px; -fx-text-fill: white;" />
                        <Pane HBox.hgrow="ALWAYS" />
                        <Button fx:id="prevBlogButton" text="Previous" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 5 15; -fx-background-radius: 5;" />
                        <Button fx:id="nextBlogButton" text="Next" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 5 15; -fx-background-radius: 5;" />
                    </HBox>
                </VBox>

                <!-- Featured Image -->
                <StackPane style="-fx-padding: 0 10 0 10;">
                    <ImageView fx:id="imageView" preserveRatio="true"
                               fitHeight="400" 
                               style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 15, 0, 0, 3);" />
                </StackPane>

                <!-- Content Section -->
                <VBox spacing="15"
                      style="-fx-background-color: white; -fx-padding: 30; 
                             -fx-background-radius: 10; 
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);"
                      maxWidth="Infinity">
                    <TextArea fx:id="contentArea" editable="false" wrapText="true"
                              style="-fx-font-size: 18px; -fx-background-color: transparent; 
                                     -fx-border-color: transparent; -fx-text-fill: #2c3e50; 
                                     -fx-font-family: 'Segoe UI', Arial, sans-serif;" />
                </VBox>

                <!-- Interaction Section -->
                <VBox spacing="10"
                      style="-fx-padding: 20; 
                             -fx-background-color: white; 
                             -fx-background-radius: 10; 
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);"
                      maxWidth="Infinity">
                    <HBox spacing="15" alignment="CENTER">
                        <Button fx:id="likeButton" text="Like"
                                style="-fx-background-color: #3498db; -fx-text-fill: white; 
                                       -fx-font-weight: bold; -fx-padding: 10 25; -fx-background-radius: 5;" />
                        <TextField fx:id="commentField" promptText="Share your thoughts..."
                                   HBox.hgrow="ALWAYS"
                                   style="-fx-background-color: #f8f9fa; -fx-border-color: #e9ecef; 
                                          -fx-border-radius: 5; -fx-padding: 10; -fx-font-size: 14px;" />
                        <Button fx:id="gifPickerButton" text="GIF" onAction="#handleOpenGifPicker"
                                style="-fx-background-color: #e67e22; -fx-text-fill: white; 
                                       -fx-font-weight: bold; -fx-padding: 10 25; -fx-background-radius: 5;" />
                        <Button fx:id="commentButton" text="Post" onAction="#handleAddComment"
                                style="-fx-background-color: #2ecc71; -fx-text-fill: white; 
                                       -fx-font-weight: bold; -fx-padding: 10 25; -fx-background-radius: 5;" />
                        <Button fx:id="backButton" text="Back"
                                style="-fx-background-color: #95a5a6; -fx-text-fill: white; 
                                       -fx-font-weight: bold; -fx-padding: 10 25; -fx-background-radius: 5;" />
                    </HBox>
                    
                    <!-- GIF Picker Panel (positioned under the comment field) -->
                    <VBox fx:id="gifPickerPane" visible="false" managed="false"
                          style="-fx-background-color: white; -fx-border-color: #ccc; -fx-padding: 15; 
                                 -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0, 0, 2);"
                          minHeight="350" maxHeight="450" VBox.vgrow="ALWAYS">
                    </VBox>
                </VBox>

                <!-- Comments Section -->
                <VBox spacing="15"
                      style="-fx-padding: 20; -fx-background-color: white; 
                             -fx-background-radius: 10; 
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);"
                      maxWidth="Infinity">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Comments"
                               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                        <Label fx:id="commentCountLabel" text="(0)"
                               style="-fx-font-size: 18px; -fx-text-fill: #7f8c8d;" />
                        <Pane HBox.hgrow="ALWAYS" />
                        <ToggleButton fx:id="newestFirstToggle" text="Newest First"
                                      style="-fx-background-color: #ecf0f1; -fx-text-fill: #34495e; 
                                             -fx-font-size: 12px; -fx-padding: 5 10; -fx-background-radius: 3;" />
                    </HBox>
                    <ListView fx:id="commentsListView" prefHeight="400" styleClass="comment-list"
                              style="-fx-background-color: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS" />
                </VBox>

                <Region fx:id="spacer" VBox.vgrow="ALWAYS"/>
            </VBox>
        </ScrollPane>
    </center>

    <!-- Removed duplicate GIF Picker Pane -->
</BorderPane>
