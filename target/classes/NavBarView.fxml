<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>

<HBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.esprit.controllers.NavBarController"
      spacing="15" alignment="CENTER_LEFT" styleClass="nav-bar">

    <!-- Back Button -->
    <Button fx:id="backButton" text="Back" styleClass="btn-back"/>

    <!-- Left side: Category and Search -->
    <HBox spacing="10" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
        <ComboBox fx:id="categoryComboBox" prefWidth="180" promptText="Select Category" styleClass="category-combo"/>
        <TextField fx:id="searchTextField" prefWidth="250" promptText="Search renewable products..." styleClass="search-field"/>
        <Button fx:id="clearFilterButton" text="Clear" styleClass="btn-clear"/>
    </HBox>

    <!-- Right side: Panier and Wishlist -->
    <HBox spacing="15" alignment="CENTER_RIGHT">
        <Button fx:id="panierButton" text="🛒 Panier" styleClass="btn-panier"/>
        <Button fx:id="wishlistButton" text="❤️ Wishlist" styleClass="btn-wishlist"/>
    </HBox>
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
</HBox>