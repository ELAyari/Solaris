<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.net.URL?>

<ScrollPane fitToWidth="true" styleClass="main-content-scroll"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.esprit.controllers.ClaimsController">
    <stylesheets>
        <URL value="@styles/common.css" />
        <URL value="@styles/animations.css" />
        <URL value="@styles/modern_effects.css" />
    </stylesheets>
    <VBox spacing="20" styleClass="main-content">
        <padding>
            <Insets top="30" right="40" bottom="30" left="40" />
        </padding>
        <Label text="Claims Management" styleClass="section-title" />
        <TableView fx:id="claimsTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId" prefWidth="80" text="Tiecket" />
                <TableColumn fx:id="colUserId" prefWidth="100" text="nom &amp; prenom" />
                <TableColumn fx:id="colReport" prefWidth="500" text="Report" />
                <TableColumn fx:id="colStatus" prefWidth="150" text="Status" />
                <TableColumn fx:id="colCreatedAt" prefWidth="200" text="Created At" />
            </columns>
            <placeholder>
                <Label text="No claims found" />
            </placeholder>
        </TableView>
        <HBox alignment="CENTER_RIGHT" spacing="10">
            <Button fx:id="btnRefresh" styleClass="action-button" text="Refresh" />
        </HBox>
    </VBox>
</ScrollPane>
