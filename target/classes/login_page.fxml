<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="600" prefWidth="900" styleClass="root" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.esprit.controllers.LoginController">
    <stylesheets>
        <URL value="@styles/energy.css" />
        <URL value="@styles/animations.css" />
        <URL value="@styles/modern_effects.css" />
    </stylesheets>

    <GridPane AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
        <columnConstraints>
            <ColumnConstraints percentWidth="60" />
            <ColumnConstraints percentWidth="40" />
        </columnConstraints>

        <!-- Left Panel -->
        <VBox alignment="CENTER" prefHeight="800.0" prefWidth="1200.0" spacing="30" styleClass="welcome-panel" GridPane.columnIndex="0">
            <padding>
                <Insets bottom="50" left="50" right="50" top="50" />
            </padding>

            <ImageView fx:id="welcomeLogoImage" fitHeight="150" fitWidth="250" pickOnBounds="true" preserveRatio="true">
                <image>
                    <Image url="@logo/logosb.png" />
                </image>
            </ImageView>

            <Text styleClass="app-title" text="Solaris Energy" />
            <Text styleClass="welcome-text" text="Bienvenue dans votre espace énergie" />
            <Text styleClass="slogan-text" text="Gérez votre énergie intelligemment" />
        </VBox>

        <!-- Right Panel - Login Form -->
        <VBox alignment="CENTER" spacing="25" styleClass="login-panel" GridPane.columnIndex="1">
            <padding>
                <Insets bottom="50" left="40" right="40" top="50" />
            </padding>

            <Text styleClass="login-title" text="Connexion" />

            <VBox fx:id="loginFormContainer" alignment="CENTER" maxWidth="300" spacing="20">
                <!-- Logo at the top of the login form -->
                <ImageView fx:id="logoImage" fitHeight="80" fitWidth="180" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@logo/logosb.png" />
                    </image>
                    <VBox.margin>
                        <Insets bottom="10" />
                    </VBox.margin>
                </ImageView>
                
                <!-- Error message label -->
                <Label fx:id="lblErrorMessage" styleClass="error-message" visible="false" wrapText="true" />

                <!-- Loading indicator -->
                <ProgressIndicator fx:id="progressIndicator" visible="false" maxWidth="50" maxHeight="50" />

                <VBox spacing="8">
                    <Label styleClass="input-label" text="Email">
                        <tooltip>
                            <Tooltip text="Votre adresse email" />
                        </tooltip>
                    </Label>
                    <TextField fx:id="tfEmail" promptText="Votre email" styleClass="modern-input">
                        <tooltip>
                            <Tooltip text="Entrez votre adresse email" />
                        </tooltip>
                    </TextField>
                </VBox>

                <VBox spacing="8">
                    <Label styleClass="input-label" text="Mot de passe">
                        <tooltip>
                            <Tooltip text="Votre mot de passe" />
                        </tooltip>
                    </Label>
                    <PasswordField fx:id="tfPassword" promptText="Votre mot de passe" styleClass="modern-input">
                        <tooltip>
                            <Tooltip text="Entrez votre mot de passe" />
                        </tooltip>
                    </PasswordField>
                </VBox>

                <HBox alignment="CENTER_RIGHT">
                    <Hyperlink onAction="#handleForgetPassword" styleClass="forgot-password" text="Mot de passe oublié ?">
                        <tooltip>
                            <Tooltip text="Récupérez votre mot de passe" />
                        </tooltip>
                    </Hyperlink>
                </HBox>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <CheckBox fx:id="cbRememberMe" text="Se souvenir de moi">
                        <tooltip>
                            <Tooltip text="Rester connecté sur cet appareil" />
                        </tooltip>
                    </CheckBox>
                </HBox>

                <Button fx:id="btnLogin" maxWidth="Infinity" onAction="#handleLogin" styleClass="login-button" text="SE CONNECTER">
                    <tooltip>
                        <Tooltip text="Connectez-vous à votre compte" />
                    </tooltip>
                </Button>

                <HBox alignment="CENTER" spacing="10">
                    <Label styleClass="register-text" text="Pas encore de compte ?">
                        <tooltip>
                            <Tooltip text="Créez un nouveau compte" />
                        </tooltip>
                    </Label>
                    <Button onAction="#handleRegister" styleClass="register-button" text="S'inscrire">
                        <tooltip>
                            <Tooltip text="Créez un nouveau compte" />
                        </tooltip>
                    </Button>
                </HBox>
            </VBox>

            <VBox alignment="CENTER" spacing="5">
                <Label styleClass="footer-text" text="powered by solaris.org" />
                <Label styleClass="version-text" text="Version 0.5" />
            </VBox>
        </VBox>
      <rowConstraints>
         <RowConstraints />
      </rowConstraints>
    </GridPane>
</AnchorPane>
