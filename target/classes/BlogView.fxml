<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.ImageView?>

<ScrollPane fx:id="mainScrollPane" fitToWidth="true" styleClass="green-scroll-pane blog-scrollpane"
            xmlns:fx="http://javafx.com/fxml" fx:controller="com.esprit.controllers.BlogViewController"
            stylesheets="@/styles/styles.css">
    <StackPane fx:id="contentPane" style="-fx-background-color: #f8f9fa; -fx-padding: 20;">
        <BorderPane>
            <top>
                <VBox spacing="20" style="-fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                    <!-- Header Section with Gradient Background -->
                    <VBox spacing="15" alignment="CENTER"
                          style="-fx-background-color: linear-gradient(to bottom, #a8e063, #56ab2f); 
                                 -fx-padding: 30;">
                        <Label text="Blog Posts" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 10, 0, 0, 2);" />
                        <Label text="Discover and share your thoughts" style="-fx-font-size: 18px; -fx-text-fill: white; -fx-opacity: 0.9;" />
                    </VBox>

                    <!-- Search and Filter Section -->
                    <HBox spacing="15" alignment="CENTER" style="-fx-padding: 20;">
                        <TextField fx:id="searchField" promptText="Search blogs..." prefWidth="400" 
                                  style="-fx-background-color: #f8f9fa; -fx-border-color: #e9ecef; -fx-border-radius: 5; -fx-padding: 10; -fx-font-size: 14px;" />
                        <ComboBox fx:id="categoryFilter" promptText="Filter by category" prefWidth="200" 
                                 style="-fx-background-color: #f8f9fa; -fx-border-color: #e9ecef; -fx-border-radius: 5; -fx-padding: 5;" />
                        <Button fx:id="addBlogButton" text="Create New Blog" 
                                style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 5; -fx-cursor: hand;" />
                    </HBox>
                </VBox>
            </top>
            <center>
                <VBox spacing="20" >
                    <!-- Loading Indicator -->
                    <ProgressIndicator fx:id="loadingIndicator" visible="false" 
                                     style="-fx-progress-color: #3498db;" />
                    <!-- Blog Cards Grid -->
                    <FlowPane fx:id="blogCardsContainer" hgap="20" vgap="20" 
                             style="-fx-padding: 20; -fx-background-color: transparent;" />
                </VBox>
            </center>
        </BorderPane>
    </StackPane>
</ScrollPane>
